#!/bin/sh
# Rombica SmartBox A2 (1 GB RAM): 1 GB swap file next to zram, made once on the first boot
# (the image does not carry it). Browsers hang the box without it.
[ -f /swapfile ] && exit 0
fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile >/dev/null || exit 1
grep -q "^/swapfile " /etc/fstab || echo "/swapfile none swap sw,pri=10 0 0" >> /etc/fstab
swapon /swapfile

            };
        };
        jtag_apee_pin {
            phandle = <0x93>;
            mux {
                groups = "jtag_tdi_1", "jtag_tdo_1", "jtag_clk_1", "jtag_tms_1";
                function = "jtag";
            };
        };
        a_uart {
            phandle = <0x15>;
            mux {
                groups = "uart_tx_a", "uart_rx_a", "uart_cts_a", "uart_rts_a";
                function = "uart_a";
            };
        };
        b_uart {
            phandle = <0x16>;
            mux {
                groups = "uart_tx_b", "uart_rx_b", "uart_cts_b", "uart_rts_b";
                function = "uart_b";
            };
        };
        c_uart {
            phandle = <0x17>;
            mux {
                groups = "uart_tx_c", "uart_rx_c", "uart_cts_c", "uart_rts_c";
                function = "uart_c";
            };
        };
        wifi_32k_pins {
            phandle = <0x35>;
            mux {
                groups = "pwm_e";
                function = "pwm_e";
            };
        };
        ao_to_sd_uart_clr_pins {
            phandle = <0x94>;
            mux {
                groups = "sdcard_d2", "sdcard_d3";
                function = "sdcard";
                input-enable;
                bias-pull-up;
            };
        };
        sd_1bit_pins {
            phandle = <0x3D>;
            mux {
                groups = "sdcard_d0", "sdcard_cmd", "sdcard_clk";
                function = "sdcard";
                input-enable;
                bias-pull-up;
            };
        };
        ao_to_sd_uart_pins {
            phandle = <0x3F>;
            mux {
                groups = "uart_tx_ao_a_card4", "uart_rx_ao_a_card5";
                function = "uart_ao_a_card";
                bias-pull-up;
                input-enable;
            };
        };
        emmc_clk_cmd_pins {
            phandle = <0x38>;
            mux {

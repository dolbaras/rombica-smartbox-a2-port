        lcd_ttl_de_on_pin {
            phandle = <0xA7>;
            mux {
                groups = "tcon_cph", "tcon_oeh";
                function = "lcd_ttl";
            };
        };
        lcd_ttl_hvsync_on_pin {
            phandle = <0xA8>;

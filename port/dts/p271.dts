        a_i2c {
            phandle = <0x98>;
            mux {
                groups = "i2c_sda_a", "i2c_scl_a";
                function = "i2c_a";
            };
        };
        b_i2c {
            phandle = <0x99>;
            mux {
                groups = "i2c_sda_b", "i2c_scl_b";
                function = "i2c_b";
            };
        };
        c_i2c {
            phandle = <0x9A>;
            mux {
                groups = "i2c_sda_c_dv28", "i2c_scl_c_dv29";
                function = "i2c_c";
            };
        };
        c_i2c_pin1 {
            phandle = <0x9B>;
            mux {
                groups = "i2c_sda_c_dv18", "i2c_scl_c_dv19";
                function = "i2c_c";
            };
        };
        d_i2c {
            phandle = <0x9C>;
            mux {
                groups = "i2c_sda_d", "i2c_scl_d";
                function = "i2c_d";
            };
        };
        spicc_pulldown_z11z12z13 {
            phandle = <0x9D>;
            mux {
                groups = "spi_sclk_0", "spi_miso_0", "spi_mosi_0";
                function = "spi";
            };
        };
        spicc_pullup_z11z12z13 {
            phandle = <0x9E>;
            mux {
                groups = "spi_sclk_0", "spi_miso_0", "spi_mosi_0";
                function = "spi";
            };
        };
        spicc_pulldown_x8x9x11 {
            phandle = <0x13>;
            mux {
                groups = "spi_sclk_1", "spi_miso_1", "spi_mosi_1";
                function = "spi";
                bias-pull-down;
            };
        };
        spicc_pullup_x8x9x11 {
            phandle = <0x14>;
            mux {
                groups = "spi_sclk_1", "spi_miso_1", "spi_mosi_1";
                function = "spi";
                bias-pull-up;
            };
        };
        audio_i2s {
            phandle = <0x5C>;
            mux {
                groups = "i2s_am_clk", "i2s_ao_clk_out", "i2s_lr_clk_out", "i2sout_ch01";
                function = "i2s";
            };
        };
        audio_spdif {
            phandle = <0x5B>;
            mux {
                groups = "spdif_out";
                function = "spdif_out";
            };
        };
        audio_spdif_in {
            phandle = <0x9F>;
            mux {

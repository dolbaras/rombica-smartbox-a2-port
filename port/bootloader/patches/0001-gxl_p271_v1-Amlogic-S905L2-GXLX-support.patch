diff --git a/drivers/mmc/aml_sd_emmc.c b/drivers/mmc/aml_sd_emmc.c
index 49f9ce7..4e14916 100644
--- a/drivers/mmc/aml_sd_emmc.c
+++ b/drivers/mmc/aml_sd_emmc.c
@@ -191,6 +191,16 @@ void aml_sd_cfg_swth(struct mmc *mmc)
 
     sd_emmc_para_config(sd_emmc_reg, mmc->clock, aml_priv->sd_emmc_port);
 
+	/* GXLX (S905L2) SD slot: core phase 3, as the stock GXLX U-Boot uses; with the GXL default
+	 * (2) reads fail with rx CRC errors at 40 MHz. */
+	if (aml_priv->sd_emmc_port == SDIO_PORT_B &&
+	    get_cpu_id().family_id == MESON_CPU_MAJOR_ID_GXLX) {
+		sd_emmc_clkc = sd_emmc_reg->gclock;
+		sd_emmc_clkc &= ~(3 << Cfg_co_phase);
+		sd_emmc_clkc |= (3 << Cfg_co_phase);
+		sd_emmc_reg->gclock = sd_emmc_clkc;
+	}
+
 	if (mmc->cfg->ops->calc && (!strcmp(mmc->cfg->name, "SDIO Port C"))) {
 		mmc->clk_lay.source = mmc->clock * clk_div;
 		mmc->clk_lay.core = mmc->clock;

 arch/arm/cpu/armv8/gxl/hdmitx20/hdmitx_set.c |  6 ++--
 board/amlogic/configs/gxl_p271_v1.h          | 33 +++++++++++++-------
 board/amlogic/gxl_p271_v1/gxl_p271_v1.c      |  3 +-
 drivers/adc/saradc.c                         |  1 +
 drivers/mmc/aml_sd_emmc.c                    | 10 ++++++
 drivers/vpp/aml_vpp.c                        |  1 +
 drivers/vpu/aml_vpu.c                        |  1 +
 7 files changed, 41 insertions(+), 14 deletions(-)


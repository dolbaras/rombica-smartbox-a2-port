+/*
+ * hdmitx sink_mode: make outputmode (after "hdmitx hpd": the saved hdmimode) a
+ * mode the connected sink can show, before "vout output $outputmode".
+ * The sink's EDID decides, as in the kernel: outputmode stays if the sink
+ * lists it and it is within the sink's range limits; else this boot uses the
+ * sink's native mode (a monitor's first detailed timing, e.g. 1280x1024p60hz,
+ * or a TV's preferred mode). Only the running environment changes (outputmode
+ * and hdmimode, which the kernel takes as the mode U-Boot set): the saved
+ * choice stays, and Android sets its own output once it runs.
+ */
+static int do_sink_mode(cmd_tbl_t *cmdtp, int flag, int argc,
+	char *const argv[])
+{
+	struct hdmitx_dev *hdev = &hdmitx_device;
+	struct hdmi_format_para *para;
+	char *mode = getenv("outputmode");
+	char *hdmi_read_edid = getenv("hdmi_read_edid");
+	enum hdmi_vic vic;
+
+	if (!mode || !hdev->HWOp.get_hpd_state())
+		return CMD_RET_SUCCESS;		/* no HDMI sink */
+	if (hdmi_read_edid && hdmi_read_edid[0] == '0')
+		return CMD_RET_SUCCESS;
+	hdmitx_read_parse_edid(hdev);
+	if (!hdev->RXCap.edid_valid) {
+		printf("hdmitx: no valid EDID, outputmode %s kept\n", mode);
+		return CMD_RET_SUCCESS;
+	}
+	if (hdmi_outputmode_check(mode) == 0 &&
+	    hdmitx_edid_mode_supported(&hdev->RXCap, hdmi_get_fmt_vic(mode),
+				       strstr(mode, "420") != NULL))
+		return CMD_RET_SUCCESS;
+
+	vic = hdmitx_edid_native_mode(&hdev->RXCap);
+	para = vic == HDMI_unkown ? NULL : hdmi_get_fmt_paras(vic);
+	if (!para || !para->sname || hdmi_outputmode_check(para->sname)) {
+		printf("hdmitx: sink takes neither %s nor a mode of ours\n", mode);
+		return CMD_RET_SUCCESS;
+	}
+	printf("hdmitx: sink does not take %s, using its native mode %s\n",
+	       mode, para->sname);
+	setenv("outputmode", para->sname);
+	setenv("hdmimode", para->sname);
+	return CMD_RET_SUCCESS;
+}

+/*
+ * PC monitors (VESA modes), as in the kernel (hdmi_tx_edid.c, port patches
+ * 0011/0012): the VESA modes a sink lists in block 0 (established timings,
+ * standard timings, Established Timings III, detailed timings), its display
+ * range limits and its first detailed timing (the native mode).
+ */
+static void store_vesa(struct rx_cap *pRXCap, enum hdmi_vic vic)
+{
+	int i;
+
+	for (i = 0; i < VESA_MAX_TIMING; i++) {
+		if (pRXCap->vesa_timing[i] == vic)
+			return;
+		if (pRXCap->vesa_timing[i] == HDMI_unkown) {
+			pRXCap->vesa_timing[i] = vic;
+			return;
+		}
+	}
+}
+
+/* established timings I and II (block 0 bytes 0x23, 0x24): the 60 Hz modes */
+static void edid_established_timings(struct rx_cap *pRXCap, unsigned char *d)
+{
+	if (d[0] & (1 << 5))
+		store_vesa(pRXCap, HDMIV_640x480p60hz);
+	if (d[0] & (1 << 0))
+		store_vesa(pRXCap, HDMIV_800x600p60hz);
+	if (d[1] & (1 << 3))
+		store_vesa(pRXCap, HDMIV_1024x768p60hz);
+}
+
+/* standard timing identifiers, 2 bytes each (VESA E-EDID 1.4 3.9) */
+static void edid_standard_timings(struct rx_cap *pRXCap, unsigned char *d,
+	int n)
+{
+	struct hdmi_format_para *para;
+	unsigned int h, v;
+
+	for (; n > 0; n--, d += 2) {
+		if (d[0] <= 1 && d[1] <= 1)	/* unused (01 01) */
+			continue;
+		h = (d[0] + 31) * 8;
+		switch (d[1] >> 6) {
+		case 0:
+			v = h * 10 / 16;	/* 16:10 */
+			break;
+		case 1:
+			v = h * 3 / 4;
+			break;
+		case 2:
+			v = h * 4 / 5;
+			break;
+		default:
+			v = h * 9 / 16;
+			break;
+		}
+		para = hdmi_get_vesa_paras(h, v, (d[1] & 0x3f) + 60);
+		if (para)
+			store_vesa(pRXCap, para->vic);
+	}

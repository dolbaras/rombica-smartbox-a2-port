+
+/* the VESA mode of the given size and refresh rate (EDID standard timings) */
+struct hdmi_format_para *hdmi_get_vesa_paras(unsigned int h_active,
+	unsigned int v_active, unsigned int hz)
+{
+	struct hdmi_format_para *p;
+	int i;
+
+	for (i = 0; all_fmt_paras[i]; i++) {
+		p = all_fmt_paras[i];
+		if (p->vic >= HDMITX_VESA_OFFSET &&
+		    p->timing.h_active == h_active &&
+		    p->timing.v_active == v_active &&
+		    (p->timing.v_freq + 500) / 1000 == hz)
+			return p;
+	}
+	return NULL;
+}

+static void edid_established_timings_3(struct rx_cap *pRXCap,
+	unsigned char *d)
+{
+	static const struct {
+		unsigned char byte, bit;
+		enum hdmi_vic vic;
+	} et3[] = {
+		{0, 0, HDMIV_1152x864p75hz},
+		{1, 6, HDMIV_1280x768p60hz},
+		{1, 3, HDMIV_1280x960p60hz},
+		{1, 1, HDMIV_1280x1024p60hz},
+		{2, 7, HDMIV_1360x768p60hz},
+		{2, 5, HDMIV_1440x900p60hz},
+		{2, 1, HDMIV_1400x1050p60hz},
+		{3, 5, HDMIV_1680x1050p60hz},
+		{3, 2, HDMIV_1600x1200p60hz},
+		{4, 0, HDMIV_1920x1200p60hz},
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(et3); i++)
+		if (d[et3[i].byte] & (1 << et3[i].bit))
+			store_vesa(pRXCap, et3[i].vic);

+		/* PC monitor (VESA) modes: the position Android's systemcontrol keeps for the mode
+		 * (<mode>_x/_y/_w/_h), by default the whole screen; the OSD picture (the boot logo
+		 * or menu, display_width x display_height) keeps its aspect ratio inside it, e.g.
+		 * 1920x1080 on a 1280x1024 monitor: 1280x720 with borders above and below
+		 */
+		char key[48];
+		int fb_w = getenv_int("display_width", 1920);
+		int fb_h = getenv_int("display_height", 1080);
+
+		snprintf(key, sizeof(key), "%s_x", mode);
+		axis[0] = getenv_int(key, def_x);
+		snprintf(key, sizeof(key), "%s_y", mode);
+		axis[1] = getenv_int(key, def_y);
+		snprintf(key, sizeof(key), "%s_w", mode);
+		axis[2] = getenv_int(key, def_w);
+		snprintf(key, sizeof(key), "%s_h", mode);
+		axis[3] = getenv_int(key, def_h);
+		if (fb_w > 0 && fb_h > 0 && axis[2] > 0 && axis[3] > 0) {
+			if (axis[2] * fb_h > axis[3] * fb_w) {	/* window wider: side borders */
+				int w = axis[3] * fb_w / fb_h;
+
+				axis[0] += (axis[2] - w) / 2;
+				axis[2] = w;
+			} else {				/* window taller: top/bottom */
+				int h = axis[2] * fb_h / fb_w;
+
+				axis[1] += (axis[3] - h) / 2;
+				axis[3] = h;
+			}
+		}
 	}
 

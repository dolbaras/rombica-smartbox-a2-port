+	    hdmitx_edid_mode_supported(pRXCap, pRXCap->preferred_mode, 0))
+		return pRXCap->preferred_mode;
+	for (i = 0; i < pRXCap->VIC_count; i++)
+		if (hdmitx_edid_mode_supported(pRXCap, pRXCap->VIC[i], 0))
+			return pRXCap->VIC[i];
+	for (i = 0; i < VESA_MAX_TIMING && pRXCap->vesa_timing[i]; i++) {
+		para = hdmi_get_fmt_paras(pRXCap->vesa_timing[i]);
+		if (para && hdmitx_edid_mode_supported(pRXCap, para->vic, 0) &&
+		    para->timing.h_active * para->timing.v_active > area) {
+			area = para->timing.h_active * para->timing.v_active;
+			best = para->vic;
+		}
+	}

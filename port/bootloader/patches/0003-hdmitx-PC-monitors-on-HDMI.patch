+/* display descriptor (a detailed timing slot with pixel clock 0) */
+static void edid_display_descriptor(struct rx_cap *pRXCap, unsigned char *d)
+{
+	switch (d[3]) {
+	case TAG_RANGE_LIMITS:
+		/* max pixel clock, in 10 MHz */
+		pRXCap->range_max_pclk = d[9] * 10000;
+		break;
+	case TAG_STANDARD_TIMINGS:
+		edid_standard_timings(pRXCap, &d[5], 6);
+		break;
+	case TAG_ESTABLISHED_TIMING_III:
+		edid_established_timings_3(pRXCap, &d[6]);
+		break;
+	default:
+		break;
+	}

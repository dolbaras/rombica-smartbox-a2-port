+		if (para && para->timing.h_active == pRXCap->pmt_hactive &&
+		    para->timing.v_active == pRXCap->pmt_vactive &&
+		    (para->timing.v_freq + 500) / 1000 == pRXCap->pmt_hz &&
+		    hdmitx_edid_mode_supported(pRXCap, para->vic, 0))
+			return para->vic;
+	}

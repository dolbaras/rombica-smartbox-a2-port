+/* the first detailed timing: the sink's native mode */
+static void edid_pmt(struct rx_cap *pRXCap, unsigned char *d,
+	struct hdmi_format_para *para)
+{
+	unsigned int h, v, total;
+
+	if (para) {
+		if (para->vic >= HDMITX_VESA_OFFSET)
+			pRXCap->pmt_vesa_vic = para->vic;
+		return;
+	}
+	if (d[17] & 0x80)	/* interlaced */
+		return;
+	h = d[2] + ((d[4] >> 4) << 8);
+	v = d[5] + ((d[7] >> 4) << 8);
+	total = (h + d[3] + ((d[4] & 0xf) << 8)) *
+		(v + d[6] + ((d[7] & 0xf) << 8));
+	if (!h || !v || !total)
+		return;
+	pRXCap->pmt_hactive = h;
+	pRXCap->pmt_vactive = v;
+	/* pixel clock in 10 kHz */
+	pRXCap->pmt_hz = ((d[0] + (d[1] << 8)) * 10000 + total / 2) / total;

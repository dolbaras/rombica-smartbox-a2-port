<?xml version="1.0" encoding="utf-8"?>
<!-- SlimBOX 9.20 TvSettings res/xml/main_prefs.xml with the "bluetooth" entry replaced by the
     Rombica "Indicator" app. All references point to TvSettings' own resources (this overlay is
     linked against TvSettings.apk with package id 0x7e); the title reuses TvSettings' string
     "bluetooth", whose value this overlay replaces (res/values*/strings.xml). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@com.android.tv.settings:string/settings_app_name">
    <PreferenceCategory
        android:layout="@com.android.tv.settings:layout/preference_category_compact_layout"
        android:title="@com.android.tv.settings:string/header_category_general_settings"
        android:key="general_settings"
        android:order="2">
        <Preference
            android:icon="@com.android.tv.settings:drawable/ic_network"
            android:title="@com.android.tv.settings:string/connectivity_network_category_title"
            android:key="network"
            android:fragment="com.android.tv.settings.connectivity.NetworkFragment" />
        <Preference
            android:icon="@com.android.tv.settings:drawable/ic_device_prefs"
            android:title="@com.android.tv.settings:string/device_pref_category_title"
            android:key="device_pref"
            android:fragment="com.android.tv.settings.device.DevicePrefFragment" />
        <Preference
            android:icon="@com.android.tv.settings:drawable/ic_slim_settings"
            android:title="@com.android.tv.settings:string/header_category_sbx_settings"
            android:key="sbx_settings"
            android:fragment="com.android.tv.settings.sbxtv_settings.SbxtvSettingsFragment" />
        <Preference
            android:icon="@com.android.tv.settings:drawable/ic_settings_power"
            android:title="@com.android.tv.settings:string/bluetooth"
            android:key="rombica_indicator">
            <intent android:action="ru.rombica.indicator.SETTINGS" />
        </Preference>
        <Preference
            android:icon="@com.android.tv.settings:drawable/ic_applications"
            android:title="@com.android.tv.settings:string/applications_category_title"
            android:key="applications"
            android:fragment="com.android.tv.settings.device.apps.AppsFragment" />
        <Preference
            android:icon="@com.android.tv.settings:drawable/ic_add_an_account"
            android:title="@com.android.tv.settings:string/accounts_category_title"
            android:key="accounts_and_sign_in"
            android:fragment="com.android.tv.settings.accounts.AccountsFragment" />
    </PreferenceCategory>
</PreferenceScreen>

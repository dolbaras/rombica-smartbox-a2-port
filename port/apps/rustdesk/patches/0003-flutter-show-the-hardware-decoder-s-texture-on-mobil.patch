From 12a36121d21410f82f40a0d5699c47c3fc7a416c Mon Sep 17 00:00:00 2001
From: Dolbaras <dolbaras@localhost>
Date: Fri, 2 Oct 2026 10:04:27 +0300
Subject: [PATCH 3/5] flutter: show the hardware decoder's texture on mobile

A frame decoded into the video texture reaches the UI as
EventToUI::Texture (at most once a second, the texture refreshes
itself). On Android the image model then keeps a never drawn
placeholder image of the display size, so canvas, scale and mouse work
as before, and ImagePaint shows a Texture widget at the place and size
the image would be drawn at (FilterQuality.low: anything higher makes
Skia copy the external texture and build mipmaps every frame). Rgba
frames switch back to the image (software decoding after a fallback).
The remote page creates the texture before connecting and releases it
on close.
---
 flutter/lib/mobile/pages/remote_page.dart | 16 +++++++
 flutter/lib/models/model.dart             | 53 +++++++++++++++++++++++
 src/client/io_loop.rs                     |  2 +
 src/flutter.rs                            | 21 +++++++++
 src/ui_session_interface.rs               |  3 ++
 5 files changed, 95 insertions(+)

diff --git a/flutter/lib/mobile/pages/remote_page.dart b/flutter/lib/mobile/pages/remote_page.dart
index 8395f45..a9e7abd 100644
--- a/flutter/lib/mobile/pages/remote_page.dart
+++ b/flutter/lib/mobile/pages/remote_page.dart
@@ -94,6 +94,8 @@ class _RemotePageState extends State<RemotePage> with WidgetsBindingObserver {
   void initState() {
     super.initState();
     gFFI.ffiModel.updateEventListener(sessionId, widget.id);
+    // before the first frame, so the hardware decoder can render into it
+    gFFI.imageModel.createSurfaceTexture();
     gFFI.start(
       widget.id,
       password: widget.password,
@@ -1154,6 +1156,20 @@ class ImagePaint extends StatelessWidget {
       }
     }
     final adjust = c.getAdjustY();
+    final image = m.image;
+    final textureId = m.surfaceTextureId;
+    if (m.surfaceActive && textureId != null && image != null) {
+      // same place and size ImagePainter would draw the image at
+      return Positioned(
+        left: (c.x / s).toInt() * s,
+        top: ((c.y + adjust) / s).toInt() * s,
+        width: image.width * s,
+        height: image.height * s,
+        // low = plain bilinear; anything higher makes Skia copy the external
+        // texture and build mipmaps for every frame, too much for a Mali-450
+        child: Texture(textureId: textureId, filterQuality: FilterQuality.low),
+      );
+    }
     return CustomPaint(
       painter: ImagePainter(
           image: m.image, x: c.x / s, y: (c.y + adjust) / s, scale: s),
diff --git a/flutter/lib/models/model.dart b/flutter/lib/models/model.dart
index 175e3ff..9b09479 100644
--- a/flutter/lib/models/model.dart
+++ b/flutter/lib/models/model.dart
@@ -1943,7 +1943,53 @@ class ImageModel with ChangeNotifier {
     _webDecodingRgba = false;
   }
 
+  // Android: texture the hardware decoder renders the remote screen into.
+  int? surfaceTextureId;
+  bool _surfaceActive = false;
+
+  bool get surfaceActive => _surfaceActive && surfaceTextureId != null;
+
+  Future<void> createSurfaceTexture() async {
+    if (!isAndroid || surfaceTextureId != null) return;
+    try {
+      final id = await platformFFI.invokeMethod("create_video_texture");
+      if (id is int && id >= 0) surfaceTextureId = id;
+    } catch (e) {
+      debugPrint('create_video_texture: $e');
+    }
+  }
+
+  void releaseSurfaceTexture() {
+    if (surfaceTextureId == null) return;
+    surfaceTextureId = null;
+    _surfaceActive = false;
+    platformFFI.invokeMethod("release_video_texture");
+  }
+
+  // Frames of this display are on the texture. The rest of the session (canvas,
+  // scale, mouse) works with the image size, so keep a never drawn placeholder
+  // image of the display size.
+  onSurfaceFrame(int display) async {
+    final rect = parent.target?.ffiModel.pi.getDisplayRect(display);
+    final w = rect?.width.toInt() ?? 0;
+    final h = rect?.height.toInt() ?? 0;
+    if (w <= 0 || h <= 0 || surfaceTextureId == null) return;
+    final activated = !_surfaceActive;
+    _surfaceActive = true;
+    if (_image == null || _image!.width != w || _image!.height != h) {
+      final pid = parent.target?.id;
+      final image = await img.decodeImageFromPixels(
+          Uint8List(w * h * 4), w, h, ui.PixelFormat.rgba8888);
+      if (parent.target?.id != pid) return;
+      await update(image);
+    } else if (activated) {
+      notifyListeners();
+    }
+  }
+
   onRgba(int display, Uint8List rgba) async {
+    // frames come as rgba again (e.g. software decoding after a fallback)
+    _surfaceActive = false;
     try {
       await decodeAndUpdate(display, rgba);
     } catch (e) {
@@ -2017,6 +2063,7 @@ class ImageModel with ChangeNotifier {
   void disposeImage() {
     _image?.dispose();
     _image = null;
+    releaseSurfaceTexture();
   }
 }
 
@@ -3925,6 +3972,12 @@ class FFI {
         } else if (message is EventToUI_Texture) {
           final display = message.field0;
           final gpuTexture = message.field1;
+          if (isAndroid) {
+            // the hardware decoder renders into the video texture
+            await imageModel.onSurfaceFrame(display);
+            onEvent2UIRgba();
+            return;
+          }
           debugPrint(
               "EventToUI_Texture display:$display, gpuTexture:$gpuTexture");
           if (gpuTexture && !hasGpuTextureRender) {
diff --git a/src/client/io_loop.rs b/src/client/io_loop.rs
index c0eb7fb..45cbc2a 100644
--- a/src/client/io_loop.rs
+++ b/src/client/io_loop.rs
@@ -2455,6 +2455,8 @@ impl<T: InvokeUiSession> Remote<T> {
                 } else {
                     #[cfg(all(feature = "vram", feature = "flutter"))]
                     handler.on_texture(display, _texture);
+                    #[cfg(all(feature = "mediacodec", feature = "flutter"))]

diff --git a/src/flutter.rs b/src/flutter.rs
index e6b325c..c5e3829 100644
--- a/src/flutter.rs
+++ b/src/flutter.rs
@@ -890,6 +890,27 @@ impl InvokeUiSession for FlutterHandler {
         }
     }
 
+    #[cfg(feature = "mediacodec")]
+    fn on_surface_frame(&self, display: usize) {
+        // the texture refreshes itself; tell the UI to show it, at most once a second
+        lazy_static::lazy_static! {
+            static ref LAST: std::sync::Mutex<HashMap<usize, std::time::Instant>> = Default::default();
+        }
+        let mut last = LAST.lock().unwrap();
+        if last
+            .get(&display)
+            .is_some_and(|t| t.elapsed() < std::time::Duration::from_secs(1))
+        {
+            return;
+        }
+        last.insert(display, std::time::Instant::now());
+        for (_, session) in self.session_handlers.read().unwrap().iter() {
+            if let Some(stream) = &session.event_stream {
+                stream.add(EventToUI::Texture(display, false));
+            }
+        }
+    }
+
     fn set_peer_info(&self, pi: &PeerInfo) {
         let displays = Self::make_displays_msg(&pi.displays);
         let mut features: HashMap<&str, bool> = Default::default();
diff --git a/src/ui_session_interface.rs b/src/ui_session_interface.rs
index bf2e04c..5fd7c55 100644
--- a/src/ui_session_interface.rs
+++ b/src/ui_session_interface.rs
@@ -1737,6 +1737,9 @@ pub trait InvokeUiSession: Send + Sync + Clone + 'static + Sized + Default {
     fn next_rgba(&self, display: usize);
     #[cfg(all(feature = "vram", feature = "flutter"))]
     fn on_texture(&self, display: usize, texture: *mut c_void);
+    /// A frame was decoded straight into the video texture (Android MediaCodec).
+    #[cfg(all(feature = "mediacodec", feature = "flutter"))]
+    fn on_surface_frame(&self, _display: usize) {}
     fn set_multiple_windows_session(&self, sessions: Vec<WindowsSession>);
     fn set_current_display(&self, disp_idx: i32);
     #[cfg(feature = "flutter")]

@@ -47,6 +49,11 @@ class MainActivity : FlutterActivity() {
     private val logTag = "mMainActivity"
     private var mainService: MainService? = null
 
+    // texture the hardware video decoder renders into, shared by the remote pages
+    private var videoTexture: TextureRegistry.SurfaceTextureEntry? = null
+    private var videoSurface: Surface? = null
+    private var videoTextureUsers = 0
+
     private var isAudioStart = false
     private val audioRecordHandle = AudioRecordHandle(this, { false }, { isAudioStart })
 
@@ -104,8 +111,43 @@ class MainActivity : FlutterActivity() {
         }
     }
 
+    private fun createVideoTexture(): Long {
+        if (videoTexture == null) {
+            val entry = flutterEngine?.renderer?.createSurfaceTexture() ?: return -1
+            val surface = Surface(entry.surfaceTexture())
+            try {
+                FFI.setVideoSurface(surface)
+            } catch (e: UnsatisfiedLinkError) {
+                Log.e(logTag, "setVideoSurface: $e")
+                surface.release()
+                entry.release()
+                return -1
+            }
+            videoTexture = entry
+            videoSurface = surface
+        }
+        videoTextureUsers++
+        return videoTexture!!.id()
+    }
+
+    private fun releaseVideoTexture(all: Boolean) {
+        videoTextureUsers = if (all) 0 else maxOf(videoTextureUsers - 1, 0)
+        if (videoTextureUsers > 0 || videoTexture == null) {
+            return
+        }
+        try {
+            FFI.setVideoSurface(null)
+        } catch (e: UnsatisfiedLinkError) {
+        }
+        videoSurface?.release()
+        videoTexture?.release()
+        videoSurface = null
+        videoTexture = null
+    }
+
     override fun onDestroy() {
         Log.e(logTag, "onDestroy")
+        releaseVideoTexture(true)
         mainService?.let {
             unbindService(serviceConnection)
         }
@@ -129,6 +171,13 @@ class MainActivity : FlutterActivity() {
         flutterMethodChannel.setMethodCallHandler { call, result ->
             // make sure result will be invoked, otherwise flutter will await forever
             when (call.method) {
+                "create_video_texture" -> {
+                    result.success(createVideoTexture())
+                }
+                "release_video_texture" -> {
+                    releaseVideoTexture(false)
+                    result.success(null)
+                }
                 "init_service" -> {
                     Intent(activity, MainService::class.java).also {
                         bindService(it, serviceConnection, Context.BIND_AUTO_CREATE)
@@ -307,6 +356,10 @@ class MainActivity : FlutterActivity() {
                     hw = false
                 } else if (listOf("c2.qti", "OMX.qcom.video", "OMX.Exynos", "OMX.hisi", "OMX.MTK", "OMX.Intel", "OMX.Nvidia").any { codec.name.startsWith(it, true) }) {
                     hw = true
+                } else if (!codec.isEncoder) {
+                    // decoders: anything that is not a known software one is a vendor (hardware) decoder,
+                    // e.g. OMX.amlogic.* on Android TV boxes
+                    hw = true
                 }
             }
             if (hw != true) {
@@ -346,9 +399,6 @@ class MainActivity : FlutterActivity() {
                         codecObject.put("low_latency", caps.isFeatureSupported(MediaCodecInfo.CodecCapabilities.FEATURE_LowLatency))
                     }
                 }
-                if (!codec.isEncoder) {
-                    return@forEach
-                }
                 codecArray.put(codecObject)
             }
         }

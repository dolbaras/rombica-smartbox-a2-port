+    fn new_codec(&self) -> ResultType<MediaCodec> {
+        match MediaCodec::from_codec_name(&self.name) {
+            Some(codec) => Ok(codec),
+            None => bail!("failed to create {}", self.name),
+        }
+    }
+
+    fn configure(&self, codec: &MediaCodec, w: usize, h: usize, surface: bool) -> ResultType<()> {
+        let mime = mime_type(self.format).unwrap_or_default();
+        let fmt = MediaFormat::new();
+        fmt.set_str("mime", mime);
+        fmt.set_i32("width", w as _);
+        fmt.set_i32("height", h as _);
+        if !surface {
+            fmt.set_i32("color-format", COLOR_FORMAT_YUV420_SEMIPLANAR);
+        }
+        fmt.set_i32("low-latency", 1);
+        fmt.set_i32("vendor.low-latency.enable", 1);
+        let window = if surface {
+            self.surface.as_ref().map(|(w, _)| w)
+        } else {
+            None
+        };
+        if let Err(e) = codec.configure(&fmt, window, MediaCodecDirection::Decoder) {
+            bail!("failed to configure {}: {e:?}", self.name);
+        }
+        if let Err(e) = codec.start() {
+            bail!("failed to start {}: {e:?}", self.name);
+        }
+        Ok(())
+    }
+
+    fn stop_codec(&mut self) {
+        if let Some((state, thread)) = self.render.take() {
+            state.stop.store(true, Ordering::Relaxed);
+            thread.join().ok();
+        }
+        if let Some(codec) = self.codec.take() {
+            codec.stop().ok();
+        }
+    }
+
+    fn start_render_thread(&mut self) {
+        let Some(codec) = self.codec.clone() else {
+            return;
+        };
+        let state = Arc::new(RenderState::default());
+        let st = state.clone();
+        let name = self.name.clone();
+        let thread = std::thread::spawn(move || {
+            while !st.stop.load(Ordering::Relaxed) {
+                match codec.dequeue_output_buffer(Duration::from_millis(50)) {
+                    Ok(Some(mut output)) => {
+                        // show only the newest of the frames that are ready
+                        let mut dropped = Ok(());
+                        while let Ok(Some(next)) = codec.dequeue_output_buffer(Duration::ZERO) {
+                            dropped = codec.release_output_buffer(output, false);
+                            st.rendered.fetch_add(1, Ordering::Relaxed);
+                            output = next;
+                        }
+                        if let Err(e) = dropped.and_then(|_| codec.release_output_buffer(output, true)) {
+                            *st.error.lock().unwrap() = Some(format!("{name}: render: {e:?}"));
+                            break;
+                        }
+                        st.rendered.fetch_add(1, Ordering::Relaxed);
+                    }
+                    Ok(None) => {}
+                    Err(NdkMediaError::UnknownResult(s))
+                        if s.0 == INFO_OUTPUT_FORMAT_CHANGED
+                            || s.0 == INFO_OUTPUT_BUFFERS_CHANGED => {}
+                    Err(e) => {
+                        *st.error.lock().unwrap() = Some(format!("{name}: dequeue output: {e:?}"));
+                        break;
+                    }
+                }
+            }
+        });
+        self.render = Some((state, thread));
+        self.queued = 0;
+        self.last_rendered = 0;
+        self.last_progress = Instant::now();
+    }

+fn sps_size(format: CodecFormat, data: &[u8]) -> Option<(usize, usize)> {
+    for nal in nal_units(data) {
+        match format {
+            CodecFormat::H264 if nal[0] & 0x1f == 7 => return h264_sps_size(&nal[1..]),
+            CodecFormat::H265 if nal.len() > 2 && (nal[0] >> 1) & 0x3f == 33 => {
+                return h265_sps_size(&nal[2..])
+            }
+            _ => {}
+        }
+    }
+    None
+}

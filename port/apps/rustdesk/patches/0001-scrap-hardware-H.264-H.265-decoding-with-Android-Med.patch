+fn mime_type(format: CodecFormat) -> Option<&'static str> {
+    match format {
+        CodecFormat::H264 => Some(H264_MIME_TYPE),
+        CodecFormat::H265 => Some(H265_MIME_TYPE),
+        _ => None,
+    }

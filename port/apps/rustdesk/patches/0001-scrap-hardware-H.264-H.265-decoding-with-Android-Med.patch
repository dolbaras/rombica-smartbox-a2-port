+// Surface of the Flutter texture; one decoder at a time may render into it.
+struct SurfaceSlot {
+    window: Option<NativeWindow>,
+    generation: u64,
+    in_use: bool,
+}
+
+static SURFACE: Mutex<SurfaceSlot> = Mutex::new(SurfaceSlot {
+    window: None,
+    generation: 0,
+    in_use: false,
+});
+
+extern "C" {
+    fn ANativeWindow_fromSurface(env: *mut jni::sys::JNIEnv, surface: jni::sys::jobject)
+        -> *mut c_void;
+}
+
+#[no_mangle]
+pub extern "system" fn Java_ffi_FFI_setVideoSurface(env: JNIEnv, _class: JClass, surface: JObject) {
+    let window = if surface.is_null() {
+        None
+    } else {
+        let ptr = unsafe { ANativeWindow_fromSurface(env.get_raw(), surface.as_raw()) };
+        // fromSurface returns an acquired reference, NativeWindow releases it on drop
+        NonNull::new(ptr).map(|p| unsafe { NativeWindow::from_ptr(p.cast()) })
+    };
+    let mut slot = SURFACE.lock().unwrap();
+    alog(false, &format!("video surface: {}", window.is_some()));
+    slot.window = window;
+    slot.generation += 1;
+    slot.in_use = false;
+}
+
+fn claim_surface() -> Option<(NativeWindow, u64)> {
+    let mut slot = SURFACE.lock().unwrap();
+    if slot.in_use {
+        return None;
+    }
+    let window = slot.window.clone()?;
+    slot.in_use = true;
+    Some((window, slot.generation))
+}
+
+fn release_surface(generation: u64) {
+    let mut slot = SURFACE.lock().unwrap();
+    if slot.generation == generation {
+        slot.in_use = false;
+    }
+}

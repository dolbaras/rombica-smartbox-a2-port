+/// Name of a hardware decoder with NV12 ByteBuffer output for the format.
+pub fn decoder_name(format: CodecFormat) -> Option<String> {
+    let mime = mime_type(format)?;
+    let info = crate::android::ffi::get_codec_info()?;
+    info.codecs
+        .iter()
+        .find(|c| {
+            !c.is_encoder
+                && c.hw == Some(true)
+                && c.nv12
+                && c.mime_type == mime
+                && !c.name.ends_with(".secure")
+        })
+        .map(|c| c.name.clone())
+}
